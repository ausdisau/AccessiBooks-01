}

model BulletinThread {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  topicId           String    @map("topic_id")
  authorUserId      String?   @map("author_user_id")
  authorDisplayName String    @default("AccessiBooks") @map("author_display_name") @db.VarChar(120)
  kind              String    @default("discussion") @db.VarChar(20)
  title             String    @db.VarChar(240)
  body              String
  isPinned          Boolean   @default(false) @map("is_pinned")
  isLocked          Boolean   @default(false) @map("is_locked")
  replyCount        Int       @default(0) @map("reply_count")
  reactionCount     Int       @default(0) @map("reaction_count")
  lastActivityAt    DateTime? @default(now()) @map("last_activity_at")
  createdAt         DateTime? @default(now()) @map("created_at")

  topic   BulletinTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  replies BulletinReply[]

  @@index([topicId, isPinned, lastActivityAt], map: "idx_bulletin_threads_topic_pinned")
  @@index([lastActivityAt], map: "idx_bulletin_threads_recent")
  @@map("bulletin_threads")
}

model BulletinReply {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  threadId          String    @map("thread_id")
  parentReplyId     String?   @map("parent_reply_id")
  authorUserId      String    @map("author_user_id")
  authorDisplayName String    @map("author_display_name") @db.VarChar(120)
  body              String
  reactionCount     Int       @default(0) @map("reaction_count")
  hiddenAt          DateTime? @map("hidden_at")
  createdAt         DateTime? @default(now()) @map("created_at")

  thread BulletinThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt], map: "idx_bulletin_replies_thread")
  @@map("bulletin_replies")
}

model BulletinReaction {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  userId     String    @map("user_id")
  targetType String    @map("target_type") @db.VarChar(16)
  targetId   String    @map("target_id")
  emoji      String    @default("👍") @db.VarChar(16)
  createdAt  DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId], map: "idx_bulletin_reactions_target")
  @@index([userId], map: "idx_bulletin_reactions_user")
  @@map("bulletin_reactions")
}

model LiveEvent {
  id                       String    @id @default(dbgenerated("gen_random_uuid()"))
  eventType                String    @map("event_type") @db.VarChar(32)
  title                    String    @db.VarChar(240)
  description              String
  hostUserId               String?   @map("host_user_id")
  hostDisplayName          String    @default("AccessiBooks") @map("host_display_name") @db.VarChar(120)
  bookId                   String?   @map("book_id")
  bookTitle                String?   @map("book_title") @db.VarChar(240)
  scheduledStartAt         DateTime  @map("scheduled_start_at")
  scheduledEndAt           DateTime  @map("scheduled_end_at")
  status                   String    @default("scheduled") @db.VarChar(20)
  listeningRoomId          String?   @map("listening_room_id")
  replayUrl                String?   @map("replay_url")
  rsvpCount                Int       @default(0) @map("rsvp_count")
  attendedCount            Int       @default(0) @map("attended_count")
  freeReplayPreviewSeconds Int       @default(600) @map("free_replay_preview_seconds")
  createdAt                DateTime? @default(now()) @map("created_at")

  host        User?              @relation(fields: [hostUserId], references: [id], onDelete: SetNull)
  rsvps       EventRsvp[]
  chatMessages EventChatMessage[]

  @@index([status, scheduledStartAt], map: "idx_live_events_status_start")
  @@index([scheduledStartAt], map: "idx_live_events_start")
  @@map("live_events")
}

model EventRsvp {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  eventId        String    @map("event_id")
  userId         String    @map("user_id")
  attendedAt     DateTime? @map("attended_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime? @default(now()) @map("created_at")

  event LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "uq_event_rsvps_event_user")
  @@index([eventId], map: "idx_event_rsvps_event")
  @@index([userId], map: "idx_event_rsvps_user")
  @@map("event_rsvps")
}

model EventChatMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  eventId     String    @map("event_id")
  userId      String    @map("user_id")
  displayName String    @map("display_name") @db.VarChar(120)
  body        String
  hiddenAt    DateTime? @map("hidden_at")
  createdAt   DateTime? @default(now()) @map("created_at")

  event LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt], map: "idx_event_chat_event")
  @@map("event_chat_messages")
}

model ShareClip {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  userId          String    @map("user_id")
  bookId          String    @map("book_id")
  bookTitle       String    @map("book_title") @db.VarChar(240)
  startSec        Int       @map("start_sec")
  endSec          Int       @map("end_sec")
  quote           String?
  shareToken      String    @unique @map("share_token") @db.VarChar(32)
  hideAttribution Boolean   @default(false) @map("hide_attribution")
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_share_clips_user")
  @@index([shareToken], map: "idx_share_clips_token")
  @@map("share_clips")
}

// ============================================================
// USER ACTIVITY (opt-in)
// ============================================================

model UserActivityEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()"))
  userId          String   @map("user_id")
  eventType       String   @map("event_type") @db.VarChar(50)
  bookId          String?  @map("book_id")
  bookTitle       String?  @map("book_title")
  durationSeconds Int?     @map("duration_seconds")
  outcomeTag      String?  @map("outcome_tag") @db.VarChar(40)
  note            String?
  occurredAt      DateTime @default(now()) @map("occurred_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt], map: "idx_user_activity_user_time")
  @@index([userId, eventType], map: "idx_user_activity_user_type")
  @@index([userId, bookId], map: "idx_user_activity_user_book")
  @@map("user_activity_events")
}

model UserActivityShare {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  userId         String    @map("user_id")
  caregiverLabel String    @map("caregiver_label")
  shareToken     String    @unique @map("share_token") @db.VarChar(64)
  rangeFrom      DateTime? @map("range_from")
  rangeTo        DateTime? @map("range_to")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_activity_shares_user")
  @@index([shareToken], map: "idx_user_activity_shares_token")
  @@map("user_activity_shares")
}

// ============================================================
// ENTITLEMENT CONFIG / AUTO RESPONSE LOG
// ============================================================

model EntitlementConfig {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  featureKey String   @map("feature_key")
  tier       String
  enabled    Boolean  @default(false)
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@unique([featureKey, tier], map: "ux_entitlement_config_feature_tier")
  @@map("entitlement_config")
}

model AutoResponseLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  recipient String
  sender    String
  dedupeKey String   @map("dedupe_key")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([recipient, sender, dedupeKey], map: "ux_auto_response_log_recipient_sender_key")
  @@index([expiresAt], map: "idx_auto_response_log_expires")
  @@map("auto_response_log")
}
