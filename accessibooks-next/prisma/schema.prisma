model AdCampaign {
  id                 String    @id @default(dbgenerated("gen_random_uuid()"))
  advertiserId       String    @map("advertiser_id")
  name               String
  description        String?
  status             String    @default("draft") @db.VarChar(20)
  budgetCents        Int       @default(0) @map("budget_cents")
  dailyBudgetCents   Int?      @default(0) @map("daily_budget_cents")
  spentCents         Int       @default(0) @map("spent_cents")
