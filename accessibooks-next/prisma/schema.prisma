// AccessiBooks Prisma schema
// Ported from lib/db/src/schema/schema.ts (Drizzle).
// snake_case Postgres names preserved via @map / @@map.
// Battle pass tables (battle_passes, battle_pass_milestones, battle_pass_purchases) are
// intentionally EXCLUDED. A few FK columns that referenced them are kept as plain scalars.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE CONTENT
// ============================================================

model Book {
  id                   String   @id @default(dbgenerated("gen_random_uuid()"))
  title                String
  author               String
  narrator             String?
  description          String?
  duration             Int      @default(0)
  coverImage           String?  @map("cover_image")
  audioUrl             String?  @map("audio_url")
  contentUrl           String?  @map("content_url")
  genre                String?
  publishedYear        Int?     @map("published_year")
  source               String   @default("local")
  sourceId             String?  @map("source_id")
  totalTime            String?  @map("total_time")
  language             String?  @default("English")
  contentType          String   @default("audiobook") @map("content_type")
  isPremium            Boolean  @default(false) @map("is_premium")
  freeTierAvailable    Boolean  @default(true) @map("free_tier_available")
  adSupported          Boolean  @default(true) @map("ad_supported")
  transcriptAvailable  Boolean  @default(false) @map("transcript_available")
  narrationType        String?  @map("narration_type")
  pageCount            Int?     @map("page_count")
  searchVector         String?  @map("search_vector")
  readingLevel         Int?     @map("reading_level")

  chapters               Chapter[]
  bookLoans              BookLoan[]
  loanWaitlist           LoanWaitlist[]
  bookTranscripts        BookTranscript[]
  accessibilityMetadata  AccessibilityMetadata?
  accessibilityReviews   AccessibilityReview[]

  @@index([title], map: "idx_books_title")
  @@index([author], map: "idx_books_author")
  @@index([genre], map: "idx_books_genre")
  @@index([source], map: "idx_books_source")
  @@index([contentType], map: "idx_books_content_type")
  @@index([publishedYear], map: "idx_books_published_year")
  @@index([language], map: "idx_books_language")
  @@index([isPremium], map: "idx_books_premium")
  @@index([source, contentType], map: "idx_books_source_content")
  @@index([genre, contentType], map: "idx_books_genre_content")
  @@map("books")
}

model SeederProgress {
  source         String   @id
  currentOffset  Int      @default(0) @map("current_offset")
  subjectIndex   Int      @default(0) @map("subject_index")
  nextUrl        String?  @map("next_url")
  status         String   @default("idle")
  totalInserted  Int      @default(0) @map("total_inserted")
  lastError      String?  @map("last_error")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  @@map("seeder_progress")
}

model Chapter {
  id            String @id @default(dbgenerated("gen_random_uuid()"))
  bookId        String @map("book_id")
  title         String
  chapterNumber Int    @map("chapter_number")
  startTime     Int?   @map("start_time")
  endTime       Int?   @map("end_time")
  pageStart     Int?   @map("page_start")
  pageEnd       Int?   @map("page_end")
  duration      Int?

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId], map: "idx_chapters_book_id")
  @@index([bookId, chapterNumber], map: "idx_chapters_order")
  @@map("chapters")
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire], map: "IDX_session_expire")
  @@map("sessions")
}

// ============================================================
// USERS
// ============================================================

model User {
  id                                  String    @id @default(dbgenerated("gen_random_uuid()"))
  email                               String?   @unique
  firstName                           String?   @map("first_name")
  lastName                            String?   @map("last_name")
  profileImageUrl                     String?   @map("profile_image_url")
  authProvider                        String?   @default("local") @map("auth_provider")
  providerId                          String?   @map("provider_id")
  subscriptionTier                    String?   @default("free") @map("subscription_tier")
  stripeCustomerId                    String?   @map("stripe_customer_id")
  stripeSubscriptionId                String?   @map("stripe_subscription_id")
  subscriptionEndDate                 DateTime? @map("subscription_end_date")
  stripeEasyEnglishSubscriptionItemId String?   @map("stripe_easy_english_subscription_item_id")
  createdAt                           DateTime? @default(now()) @map("created_at")
  updatedAt                           DateTime? @default(now()) @map("updated_at")
  referralCode                        String?   @unique @map("referral_code")
  referralCredits                     Int       @default(0) @map("referral_credits")
  passwordHash                        String?   @map("password_hash")
  name                                String?
  emailVerified                       DateTime? @map("email_verified")
  image                               String?
  role                                String?
  companyName                         String?   @map("company_name")
  website                             String?
  subscriptionStatus                  String?   @map("subscription_status")

  purchases                  Purchase[]
  listeningHistory           ListeningHistory[]
  reviews                    Review[]
  reviewLikes                ReviewLike[]
  followers                  UserFollow[] @relation("user_follows_follower")
  following                  UserFollow[] @relation("user_follows_following")
  playlists                  Playlist[]
  userStreak                 UserStreak[]
  userXp                     UserXp[]
  userAchievements           UserAchievement[]
  dailyListeningLogs         DailyListeningLog[]
  userGoals                  UserGoal[]
  userChallengeProgress      UserChallengeProgress[]
  referralsMade              Referral[] @relation("referrals_referrer")
  referralsReceived          Referral[] @relation("referrals_referred")
  userPreferences            UserPreferences?
  authorProfile              AuthorProfile?
  pushSubscriptions          PushSubscription[]
  notificationLog            NotificationLogEntry[]
  hostedRooms                ListeningRoom[]
  roomParticipations         ListeningRoomParticipant[]
  roomMessages               ListeningRoomMessage[]
  hostedQueues               StreamingQueue[]
  addedQueueItems            StreamingQueueItem[]
  queueVotes                 QueueVote[]
  adCampaigns                AdCampaign[]
  paymentTransactions        PaymentTransaction[]
  streakFreezes              StreakFreeze[]
  expiringRewards            ExpiringReward[]
  adRewards                  AdReward[]
  authorEarnings             AuthorEarning[]
  voicePackPurchases         VoicePackPurchase[]
  annotationSyncs            AnnotationSync[]
  giftCardsSent              GiftCard[] @relation("gift_cards_from")
  giftCardsRedeemed          GiftCard[] @relation("gift_cards_redeemed")
  enterpriseMemberships      EnterpriseMember[]
  familyAccountsOwned        FamilyAccount[]
  familyMemberships          FamilyMember[]
  authorTipsSent             AuthorTip[] @relation("author_tips_from")
  authorTipsReceived         AuthorTip[] @relation("author_tips_to")
  contentReports             ContentReport[]
  activityFeed               ActivityFeed[]
  readingClubsCreated        ReadingClub[]
  readingClubMemberships     ReadingClubMember[]
  engagementMetrics          EngagementMetric[]
  bookLoans                  BookLoan[]
  loanWaitlist               LoanWaitlist[]
  accessibilityPreferences   AccessibilityPreferences?
  accessibilityReviews       AccessibilityReview[]
  institutionalMemberships   InstitutionalMember[]
  displayAds                 DisplayAd[]
  adSlots                    AdSlot[]
  bids                       Bid[]
  advertiserWallet           AdvertiserWallet?
  publisherEarnings          PublisherEarning?
  payoutRequests             PayoutRequest[]
  wordBankEntries            WordBankEntry[]
  subscriptions              Subscription[]
  entitlements               Entitlement[]
  listeningSessions          ListeningSession[]
  engagementEvents           EngagementEvent[]
  bulletinThreads            BulletinThread[]
  bulletinReplies            BulletinReply[]
  bulletinReactions          BulletinReaction[]
  liveEventsHosted           LiveEvent[]
  eventRsvps                 EventRsvp[]
  eventChatMessages          EventChatMessage[]
  shareClips                 ShareClip[]
  userActivityEvents         UserActivityEvent[]
  userActivityShares         UserActivityShare[]
  conversations              Conversation[]
  easyEnglishUsage           EasyEnglishUsage[]

  @@map("users")
}

model Purchase {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  userId          String    @map("user_id")
  bookId          String    @map("book_id")
  bookTitle       String    @map("book_title")
  amountCents     Int       @map("amount_cents")
  currency        String?   @default("usd")
  stripePaymentId String?   @map("stripe_payment_id")
  status          String    @default("completed")
  purchasedAt     DateTime? @default(now()) @map("purchased_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_purchases_user")
  @@index([bookId], map: "idx_purchases_book")
  @@index([userId, bookId], map: "idx_purchases_user_book")
  @@map("purchases")
}

model ListeningHistory {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  userId         String    @map("user_id")
  bookId         String    @map("book_id")
  bookTitle      String    @map("book_title")
  bookAuthor     String?   @map("book_author")
  bookCover      String?   @map("book_cover")
  currentTime    Int       @default(0) @map("current_time")
  totalDuration  Int?      @map("total_duration")
  lastPlayedAt   DateTime? @default(now()) @map("last_played_at")
  completedAt    DateTime? @map("completed_at")
  playCount      Int       @default(1) @map("play_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_listening_history_user")
  @@index([lastPlayedAt], map: "idx_listening_history_last_played")
  @@map("listening_history")
}

model Review {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String    @map("user_id")
  bookId    String    @map("book_id")
  rating    Int
  title     String?
  content   String?
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes ReviewLike[]

  @@index([userId], map: "idx_reviews_user")
  @@index([bookId], map: "idx_reviews_book")
  @@index([createdAt], map: "idx_reviews_created")
  @@map("reviews")
}

model ReviewLike {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String    @map("user_id")
  reviewId  String    @map("review_id")
  createdAt DateTime? @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_review_likes_user")
  @@index([reviewId], map: "idx_review_likes_review")
  @@map("review_likes")
}

model UserFollow {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  followerId  String    @map("follower_id")
  followingId String    @map("following_id")
  createdAt   DateTime? @default(now()) @map("created_at")

  follower  User @relation("user_follows_follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("user_follows_following", fields: [followingId], references: [id], onDelete: Cascade)

  @@index([followerId], map: "idx_user_follows_follower")
  @@index([followingId], map: "idx_user_follows_following")
  @@map("user_follows")
}

model ExternalRating {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  bookId      String    @map("book_id")
  source      String
  rating      Int?
  reviewCount Int?      @map("review_count")
  lastUpdated DateTime? @default(now()) @map("last_updated")

  @@index([bookId], map: "idx_external_ratings_book")
  @@map("external_ratings")
}

model Author {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  bio             String?
  birthDate       String?   @map("birth_date")
  deathDate       String?   @map("death_date")
  photoUrl        String?   @map("photo_url")
  openLibraryKey  String?   @map("open_library_key")
  wikipedia       String?
  lastUpdated     DateTime? @default(now()) @map("last_updated")

  @@index([name], map: "idx_authors_name")
  @@index([openLibraryKey], map: "idx_authors_ol_key")
  @@map("authors")
}

model Playlist {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  userId      String?   @map("user_id")
  name        String
  description String?
  coverImage  String?   @map("cover_image")
  isPublic    Int       @default(1) @map("is_public")
  isCurated   Int       @default(0) @map("is_curated")
  category    String?
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId], map: "idx_playlists_user")
  @@index([isCurated], map: "idx_playlists_curated")
  @@index([category], map: "idx_playlists_category")
  @@map("playlists")
}

model PlaylistItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  playlistId  String    @map("playlist_id")
  bookId      String    @map("book_id")
  bookTitle   String    @map("book_title")
  bookAuthor  String?   @map("book_author")
  bookCover   String?   @map("book_cover")
  position    Int       @default(0)
  addedAt     DateTime? @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId], map: "idx_playlist_items_playlist")
  @@index([position], map: "idx_playlist_items_position")
  @@map("playlist_items")
}

// ============================================================
// GAMIFICATION
// ============================================================

model UserStreak {
  id                String  @id @default(dbgenerated("gen_random_uuid()"))
  userId            String  @map("user_id")
  currentStreak     Int     @default(0) @map("current_streak")
  longestStreak     Int     @default(0) @map("longest_streak")
  lastListenedDate  String? @map("last_listened_date")
  streakStartDate   String? @map("streak_start_date")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_streaks_user")
  @@map("user_streaks")
}

model UserXp {
  id                     String @id @default(dbgenerated("gen_random_uuid()"))
  userId                 String @map("user_id")
  totalXp                Int    @default(0) @map("total_xp")
  level                  Int    @default(1)
  totalListeningMinutes  Int    @default(0) @map("total_listening_minutes")
  booksCompleted         Int    @default(0) @map("books_completed")
  reviewsWritten         Int    @default(0) @map("reviews_written")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_xp_user")
  @@index([totalXp], map: "idx_user_xp_total")
  @@map("user_xp")
}

model UserAchievement {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  userId          String    @map("user_id")
  achievementType String    @map("achievement_type")
  unlockedAt      DateTime? @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_achievements_user")
  @@map("user_achievements")
}

model DailyListeningLog {
  id              String @id @default(dbgenerated("gen_random_uuid()"))
  userId          String @map("user_id")
  date            String
  minutesListened Int    @default(0) @map("minutes_listened")
  booksStarted    Int    @default(0) @map("books_started")
  booksCompleted  Int    @default(0) @map("books_completed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date], map: "idx_daily_log_user_date")
  @@map("daily_listening_log")
}

model UserGoal {
  id                String @id @default(dbgenerated("gen_random_uuid()"))
  userId            String @map("user_id")
  dailyMinutesGoal  Int    @default(30) @map("daily_minutes_goal")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_goals_user")
  @@map("user_goals")
}

model ReadingChallenge {
  id          String  @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String?
  targetBooks Int     @map("target_books")
  startDate   String  @map("start_date")
  endDate     String  @map("end_date")
  badgeIcon   String? @map("badge_icon")
  isActive    Boolean @default(true) @map("is_active")

  participants UserChallengeProgress[]

  @@map("reading_challenges")
}

model UserChallengeProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  userId          String    @map("user_id")
  challengeId     String    @map("challenge_id")
  booksCompleted  Int       @default(0) @map("books_completed")
  completedAt     DateTime? @map("completed_at")
  joinedAt        DateTime? @default(now()) @map("joined_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge ReadingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_challenge_user")
  @@index([challengeId], map: "idx_user_challenge_challenge")
  @@map("user_challenge_progress")
}

// ============================================================
// REFERRALS / PREFERENCES / SUBMISSIONS / AUTHOR PROFILES
// ============================================================

model Referral {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  referrerId      String    @map("referrer_id")
  referredUserId  String?   @map("referred_user_id")
  referralCode    String    @unique @map("referral_code")
  status          String    @default("pending")
  creditAmount    Int       @default(100) @map("credit_amount")
  createdAt       DateTime? @default(now()) @map("created_at")

  referrer User  @relation("referrals_referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("referrals_referred", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerId], map: "idx_referrals_referrer")
  @@index([referralCode], map: "idx_referrals_code")
  @@map("referrals")
}

model UserPreferences {
  id                       String    @id @default(dbgenerated("gen_random_uuid()"))
  userId                   String    @unique @map("user_id")
  favoriteGenres           String[]  @default([]) @map("favorite_genres")
  preferredContentTypes    String[]  @default([]) @map("preferred_content_types")
  listeningHabit           String?   @map("listening_habit")
  onboardingCompleted      Boolean   @default(false) @map("onboarding_completed")
  welcomeBonusGranted      Boolean   @default(false) @map("welcome_bonus_granted")
  premiumTrialEndDate      DateTime? @map("premium_trial_end_date")
  createdAt                DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserSubmission {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  userId       String    @map("user_id")
  title        String
  author       String
  description  String?
  contentType  String    @default("audiobook") @map("content_type")
  audioUrl     String?   @map("audio_url")
  contentUrl   String?   @map("content_url")
  coverImage   String?   @map("cover_image")
  genre        String?
  language     String?   @default("English")
  status       String    @default("pending")
  createdAt    DateTime? @default(now()) @map("created_at")
  duration     Int?
  pageCount    Int?      @map("page_count")
  publishedAt  DateTime? @map("published_at")
  totalPlays   Int       @default(0) @map("total_plays")
  totalReads   Int       @default(0) @map("total_reads")
  fileSize     Int?      @map("file_size")
  narrator     String?
  tags         String[]  @default([])
  isPromoted   Boolean   @default(false) @map("is_promoted")
  authorUserId String?   @map("author_user_id")

  @@map("user_submissions")
}

model AuthorProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()"))
  userId          String    @unique @map("user_id")
  displayName     String    @map("display_name")
  bio             String?
  website         String?
  socialLinks     Json?     @map("social_links")
  profileImage    String?   @map("profile_image")
  isVerified      Boolean   @default(false) @map("is_verified")
  totalPlays      Int       @default(0) @map("total_plays")
  totalListeners  Int       @default(0) @map("total_listeners")
  createdAt       DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_author_profiles_user")
  @@map("author_profiles")
}

model ContentAnalytic {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  bookId        String    @map("book_id")
  authorUserId  String    @map("author_user_id")
  eventType     String    @map("event_type")
  listenerId    String?   @map("listener_id")
  duration      Int?
  createdAt     DateTime? @default(now()) @map("created_at")

  @@index([bookId], map: "idx_content_analytics_book")
  @@index([authorUserId], map: "idx_content_analytics_author")
  @@index([createdAt], map: "idx_content_analytics_date")
  @@map("content_analytics")
}

// ============================================================
// PODCAST INGESTION
// ============================================================

model PodcastFeed {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  feedUrl        String    @unique @map("feed_url")
  title          String
  description    String?
  imageUrl       String?   @map("image_url")
  author         String?
  language       String?
  websiteUrl     String?   @map("website_url")
  categories     Json?
  etag           String?
  lastModified   String?   @map("last_modified")
  lastFetchedAt  DateTime? @map("last_fetched_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  episodes PodcastEpisode[]

  @@index([title], map: "idx_podcast_feeds_title")
  @@map("podcast_feeds")
}

model PodcastEpisode {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  feedId            String    @map("feed_id")
  guid              String?
  title             String
  descriptionText   String?   @map("description_text")
  descriptionHtml   String?   @map("description_html")
  pubDate           DateTime? @map("pub_date")
  durationSeconds   Int?      @map("duration_seconds")
  audioUrl          String    @map("audio_url")
  audioType         String?   @map("audio_type")
  audioLengthBytes  Int?      @map("audio_length_bytes")
  explicit          Boolean?
  transcriptUrl     String?   @map("transcript_url")
  transcriptStatus  String    @default("none") @map("transcript_status")
  contentWarnings   Json?     @map("content_warnings")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")

  feed PodcastFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([feedId], map: "idx_podcast_episodes_feed")
  @@index([pubDate], map: "idx_podcast_episodes_pub_date")
  @@index([guid], map: "idx_podcast_episodes_guid")
  @@index([audioUrl], map: "idx_podcast_episodes_audio_url")
  @@map("podcast_episodes")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model PushSubscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  userId        String    @map("user_id")
  endpoint      String
  p256dh        String
  auth          String
  enabledTypes  String[]  @default(["streak_reminder", "goal_nudge", "new_content", "achievement", "recommendation", "re_engagement", "author_update", "system", "rsvp_reminder", "friend_digest", "win_back", "weekly_recap", "streak_at_risk"]) @map("enabled_types")
  createdAt     DateTime? @default(now()) @map("created_at")
  lastUsedAt    DateTime? @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_push_sub_user")
  @@index([endpoint], map: "idx_push_sub_endpoint")
  @@map("push_subscriptions")
}

model NotificationLogEntry {
  id      String    @id @default(dbgenerated("gen_random_uuid()"))
  userId  String    @map("user_id")
  type    String
