# =============================================================================
# AccessiBooks (Next.js) — example environment variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ---------------------------------------------------
# Local example: postgres://postgres:postgres@localhost:5432/accessibooks
DATABASE_URL=

# --- Auth (Auth0) ------------------------------------------------------------
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_SCOPE=openid profile email

# Optional OAuth providers (federated via Auth0 or direct)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Session secret for any non-Auth0 session signing
SESSION_SECRET=

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@accessibooks.example

# --- AI ----------------------------------------------------------------------
OPENAI_API_KEY=

# --- Object storage (S3-compatible) -----------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Optional third-party content providers ---------------------------------
ITUNES_AFFILIATE_TOKEN=
INTERNET_ARCHIVE_API_KEY=
OPEN_LIBRARY_API_KEY=
