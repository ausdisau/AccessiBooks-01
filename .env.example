# ── Required for all environments ──────────────────────────────
DATABASE_URL=              # Neon PostgreSQL connection string
SESSION_SECRET=            # Random 32+ char string for session cookies
MAGIC_LINK_SECRET=         # Random 32+ char string for magic link tokens
STRIPE_SECRET_KEY=         # Stripe secret key (sk_live_... or sk_test_...)
STRIPE_WEBHOOK_SECRET=     # Stripe webhook signing secret (whsec_...)
APP_URL=                   # Public URL of the app (https://yourapp.repl.co)

# ── Stripe price IDs (required for subscription billing) ───────
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
STRIPE_EASY_ENGLISH_PRICE_ID=

# ── Email delivery ──────────────────────────────────────────────
RESEND_API_KEY=            # Optional — email features disabled without this
RESEND_FROM_EMAIL=         # Verified sender address

# ── OAuth providers (all optional — disable auth strategy if absent) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ── AI / TTS ────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
ELEVENLABS_API_KEY=

# ── Object Storage (Replit-managed) ────────────────────────────
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ── DRM microservice ────────────────────────────────────────────
DRM_SIGNING_SECRET=
JWT_PRIVATE_KEY_PEM=

# ── Ad platform (frontend) ──────────────────────────────────────
VITE_ADSENSE_CLIENT=
VITE_DFP_NETWORK_CODE=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_SKYSCRAPER=

# ── CORS / origin ───────────────────────────────────────────────
ALLOWED_ORIGIN=            # Comma-separated list of allowed origins in production
WEB_ORIGIN=                # Web client origin for OIDC / DRM

# ── Runtime (set by Replit automatically) ──────────────────────
PORT=5000
NODE_ENV=production
REPL_ID=
