# Server
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/accessibooks
SESSION_SECRET=your-session-secret-here

# OpenAI (covers, TTS, visual reading, chat)
OPENAI_API_KEY=sk-...
# Optional overrides (legacy Replit AI integration env names still supported)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_AUDIO_CHAT_MODEL=gpt-4o-audio-preview

# Google Cloud Storage (object uploads / author assets)
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public
PRIVATE_OBJECT_DIR=/your-bucket/private

# Spotify (OAuth refresh token from your Spotify app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# DRM Service
DRM_PORT=4000
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=accessibooks-drm
JWT_AUDIENCE=accessibooks-client

# Web App (Vite)
VITE_API_URL=http://localhost:5000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Auth0 / Google / Facebook (see server/multiAuth.ts)
# AUTH0_DOMAIN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
