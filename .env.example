# =============================================================================
# AccessiBooks — copy to .env and fill in values
# =============================================================================

# Server
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/accessibooks
SESSION_SECRET=your-session-secret-here
# Set to true to auto-start catalog seeder on boot (off by default in production)
ENABLE_CATALOG_SEEDER=false
# Comma-separated origins for CORS (production)
ALLOWED_ORIGIN=https://accessibooks.com.au

# OpenAI (covers, TTS, visual reading)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_AUDIO_CHAT_MODEL=gpt-4o-audio-preview

# Google Cloud Storage (author uploads, ad creatives)
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public
PRIVATE_OBJECT_DIR=/your-bucket/private

# Content APIs
GOOGLE_BOOKS_API_KEY=
SERPAPI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Coinbase Commerce
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# DRM (main app signed URLs)
DRM_SIGNING_SECRET=your-drm-signing-secret

# OAuth — Passport (server/multiAuth.ts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Auth0 (server/auth0.ts + Passport strategy)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Push notifications (Web Push / VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@accessibooks.com.au

# Ad mediation (server)
AD_MEDIATION_URL=
HOUSE_ADS_URL=

# Web App (Vite)
VITE_API_URL=http://localhost:5000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_ADSENSE_CLIENT=
VITE_DFP_NETWORK_CODE=

# JWT for optional service-to-service auth
JWT_PRIVATE_KEY_PEM=

# DRM microservice (services/drm — deferred integration)
DRM_PORT=4000
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=accessibooks-drm
JWT_AUDIENCE=accessibooks-client
