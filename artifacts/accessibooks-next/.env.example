# AccessiBooks (Next.js) — environment variable reference.
# Copy to `.env.local` for local dev; in production set these on Vercel.
# Never commit real secrets.

# ============================================================
# Database
# ============================================================
# Postgres connection string. Same DB as the legacy Express server during
# the migration window. Use the pooled Vercel Postgres URL or your own
# managed Postgres provider's pooled endpoint for serverless workloads.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ============================================================
# Auth (NextAuth + legacy bearer JWT interop)
# ============================================================
# HS256 secret. Must match the legacy server's JWT_SECRET so tokens issued
# by either side are accepted by both during the migration. SESSION_SECRET
# is accepted as an alias.
JWT_SECRET=change-me

# Public URL of this deployment (used for OAuth callback construction).
# Vercel sets NEXTAUTH_URL automatically on previews & prod — only set
# explicitly for custom domains.
# NEXTAUTH_URL=https://accessibooks.example.com

# --- Auth0 (Replit-managed Auth0 tenant or your own) ---
# Callback URL: https://<your-domain>/api/auth/callback/auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional M2M credentials for management-API calls (account linking).
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Google OAuth ---
# Callback URL: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth ---
# Callback URL: https://<your-domain>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Microsoft OAuth ---
# Callback URL: https://<your-domain>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant: "common" for multi-tenant, or a specific tenant GUID.
MICROSOFT_TENANT_ID=common

# --- Magic-link email login (src/lib/magicLink.ts) ---
# Resend API key used to deliver the one-time link.
RESEND_API_KEY=
# From address shown in magic-link emails. Domain must be verified in Resend.
MAGIC_LINK_FROM=AccessiBooks <login@accessibooks.example>
# Token TTL in minutes (default 15).
MAGIC_LINK_TTL_MINUTES=15

# ============================================================
# Stripe billing (app/api/billing/{checkout,portal,webhook})
# ============================================================
# Server-side secret (sk_test_... in dev, sk_live_... in prod).
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard endpoint config.
# The webhook URL is https://<your-domain>/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Optional: stable Price IDs so the Customer Portal can offer plan switches.
# Without these, checkout falls back to inline price_data (still works, but
# the portal cannot offer upgrade/downgrade flows).
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
# How many days a `past_due` subscription stays entitled before being
# downgraded to free. Default 3.
BILLING_GRACE_PERIOD_DAYS=3

# ============================================================
# External content & AI APIs
# ============================================================
# OpenAI (TTS, Easy-English rewriting, agentic recommendations).
OPENAI_API_KEY=
# ElevenLabs (premium TTS voices).
ELEVENLABS_API_KEY=
# Amazon Product Advertising API (book metadata enrichment).
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
# Spotify (podcast metadata + audio previews).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# iTunes Search API has no key.
# Open Library, Project Gutenberg, LibriVox, Internet Archive — no keys.

# ============================================================
# Object storage (uploaded covers, audio, ad creatives)
# ============================================================
# Vercel Blob recommended for Vercel deploys.
BLOB_READ_WRITE_TOKEN=
# Optional S3-compatible fallback (Replit Object Storage, R2, S3).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ============================================================
# Web push (VAPID)
# ============================================================
# Generate once with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@accessibooks.example

# ============================================================
# Cron + legacy-backend bridging
# ============================================================
# Shared secret Vercel sends on cron requests as `Authorization: Bearer …`.
# Vercel auto-generates this when you enable cron in the dashboard; mirror
# it here so non-Vercel callers (e.g. local `curl`) can also trigger jobs.
CRON_SECRET=
# Base URL of the legacy Express API. Cron stubs proxy to
# `${LEGACY_API_URL}/api/internal/cron/<job>` while business logic is still
# hosted there. Leave unset to make cron runs no-op (useful for first deploy
# before the legacy backend exposes the internal endpoints).
LEGACY_API_URL=
# Shared secret the legacy server checks on /api/internal/cron/* calls.
INTERNAL_CRON_TOKEN=

# ============================================================
# Observability (optional)
# ============================================================
# Set to "debug" to enable verbose pino logs in production.
LOG_LEVEL=info
